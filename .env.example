# CLIPIN AI Layer Configuration
# Copy this file to .env.local and fill in your values

# OpenRouter API Key (required)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM Model Selection (optional)
# Defaults to: openai/gpt-4-turbo
# Available models:
#   - openai/gpt-4-turbo (best quality, higher cost)
#   - openai/gpt-4 (high quality)
#   - openai/gpt-3.5-turbo (faster, lower cost)
#   - anthropic/claude-3-opus (best reasoning)
#   - anthropic/claude-3-sonnet (balanced)
#   - google/gemini-pro (fast)
#   - meta-llama/llama-2-70b (open source)
OPENROUTER_MODEL=openai/gpt-4-turbo

# Site metadata for OpenRouter rate limiting tracking (optional)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=CLIPIN

# Video Processing (future)
# WHISPER_API_KEY=sk-...
# FFMPEG_PATH=/usr/bin/ffmpeg
# REMOTION_API_KEY=...

# Database (future)
# DATABASE_URL=postgresql://user:password@localhost:5432/clipin
# REDIS_URL=redis://localhost:6379

# Storage (future)
# AWS_S3_BUCKET=clipin-videos
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
